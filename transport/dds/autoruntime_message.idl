module autoruntime_dds {
  @final
  struct Message {
    unsigned short envelope_version;
    unsigned long long trace_id;
    unsigned long long span_id;
    unsigned long long parent_span_id;
    unsigned long long message_sequence;
    unsigned long long source_timestamp_ns;
    unsigned long long publish_timestamp_ns;
    unsigned long long source_generation;
    long priority;
    sequence<octet, 1048576> payload;
  };

  @final
  struct RpcRequest {
    unsigned short protocol_version;
    string<128> service_name;
    unsigned long long client_guid_high;
    unsigned long long client_guid_low;
    unsigned long long request_id;
    unsigned long long timeout_budget_ns;
    Message message;
  };

  @final
  struct RpcResponse {
    unsigned short protocol_version;
    string<128> service_name;
    unsigned long long client_guid_high;
    unsigned long long client_guid_low;
    unsigned long long request_id;
    unsigned short status_code;
    string<1024> error_detail;
    Message message;
  };
};
